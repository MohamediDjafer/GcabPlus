procedure TFMain.btnhover(btn : TAdvGlowButton);
begin
  if not btn.Down = True then
    begin
    HoverLine.Show;
      if  btn.Top > bleft then
        begin
          sta := 'Next';
          bleft := btn.Top;
          TimeMenu.Enabled := True;
          if  HoverLine.Left <> 5 then
            HoverLine.Left := HoverLine.Left - 20;
        end
      else
        if  btn.Top < bleft then
          begin
            sta := 'Previous';
            bleft := btn.Top;
            TimeMenu.Enabled := True;
            if  HoverLine.Left <> 5 then
              HoverLine.Left := HoverLine.Left - 20;
          end;
    end
  else
    begin
      HoverLine.Hide;
      if  btn.Top > bleft then
        begin
          sta := 'Next';
          bleft := btn.Top;
          TimeMenu.Enabled := True;
          if  HoverLine.Left <> 5 then
            HoverLine.Left := HoverLine.Left + 20;
        end
      else
        if  btn.Top < bleft then
          begin
            sta := 'Previous';
            bleft := btn.Top;
            TimeMenu.Enabled := True;
            if  HoverLine.Left <> 5 then
              HoverLine.Left := HoverLine.Left + 20;
          end;
    end;
end;

