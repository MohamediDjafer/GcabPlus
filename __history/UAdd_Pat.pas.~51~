procedure TFAdd_Pat.MenuItem1Click(Sender: TObject);
var
  ImgExt,f: string;
  jpeg: TJpegImage;
  i: Integer;
  Field: TBlobField;
  Stream: TStream;
  Jpg: TJPEGImage;
begin
  if OpenPicture.Execute then
  begin
    //data_t.Stagiaire.edit;
      f:=copy(OpenPicture.FileName,1,pos('.',OpenPicture.FileName)-1);

    // le traitement se fera d'après l'extension du fichier
    ImgExt := LowerCase(ExtractFileExt(OpenPicture.FileName));

    // Bitmap
    if ImgExt = '.bmp' then
      Image10.Picture.Bitmap.LoadFromFile(OpenPicture.FileName);

    // Jpeg
    if (ImgExt = '.jpg') or (ImgExt = '.jpeg') then
    begin
      jpeg := TJpegImage.Create;
      try
        jpeg.LoadFromFile(OpenPicture.FileName);
        // copie de l'image du jpeg dans un bitmap
        jpeg.PixelFormat:= jf8Bit;
        jpeg.CompressionQuality:=50;
        jpeg.ProgressiveDisplay:=False;
        jpeg.ProgressiveEncoding:=False;
        jpeg.Compress;
        Image10.Picture.Bitmap.Assign(jpeg);
        //image10.Picture.SaveToFile(f+'.jpg');
      finally
        jpeg.Free;
      end;

    end; { if (ImgExt = '.JPG') or (ImgExt = '.JPEG') }

    // icones
    if ImgExt = '.ico' then
      Image10.Picture.Icon.LoadFromFile(OpenPicture.FileName);

    // wmf et emf
    if Pos(ImgExt, GraphicFileMask(TMetaFile)) <> 0 then
      Image10.Picture.Metafile.LoadFromFile(OpenPicture.FileName);
  end;
end;

