procedure TConnexion.FormShow(Sender: TObject);
VAR
  Z, us: STRING;
  pr: string;
  Login: TextFile;
begin
  Registre := TRegistry.Create;
  Registre.RootKey := HKEY_CURRENT_USER;
  GetWindowsDirectory(PWindowsDir, 255);
  r := StrPas(PWindowsDir)[1];
  hdd := Trim(GetHardDiskSerial(r[1]));
  keyact := ACTIVATION(hdd);
  if Registre.KeyExists('D27') then
  BEGIN
    Registre.OpenKey('D27', true);
    keyactive := Registre.ReadString('D27MSA');
    if (keyactive = keyact) then
    begin
      CardPanel1.ActiveCard:=Conn;
      if not FileExists(ExtractFilePath(Application.ExeName) + 'loginORTH.txt')
