function GetHardDiskSerial(const DriveLetter: Char): string;
var
  NotUsed: DWORD;
  VolumeFlags: DWORD;
  VolumeInfo: array [0 .. MAX_PATH] of Char;
  VolumeSerialNumber: DWORD;
begin
  GetVolumeInformation(PChar(DriveLetter + ':\'), nil, SizeOf(VolumeInfo),
    @VolumeSerialNumber, NotUsed, VolumeFlags, nil, 0);
  Result := Format('%8.8X', [VolumeSerialNumber])
end;

function ACTIVATION(const user: STRING): string;
var
  i: integer;
  Key: longint;
  ID: string;
begin
  Key := 0;
  for i := 1 to length(user) do
    Key := Key + (i * ord(user[i]));
  Key := abs(Key * $1BAAFFE);
  if Key >= $77359400 then
    Key := Key - $77359400;
  if Key >= $3B9ACA00 then
    Key := Key - $3B9ACA00;
  Key := Key XOR $221D1758;
  if Key >= $77359400 then
    Key := Key - $77359400;
  if Key >= $3B9ACA00 then
    Key := Key - $3B9ACA00;
  str(Key, ID);
  if length(ID) < 9 then
    for i := 1 to (9 - length(ID)) do
      ID := ID + '0';
  Result := ID;
end;

