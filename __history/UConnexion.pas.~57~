        Reset(Login);
        Readln(Login, serverip);
        Readln(Login, portip);
        Readln(Login, usern);
        Readln(Login, pass);
        Readln(Login, chemin);
        Readln(Login, us);
        if us <> '' then
        begin
          INSERT_LNAME.Text := us;
          AdvOfficeCheckBox1.Checked := true;
          INSERT_FNAME.SetFocus;
        end
        else
        begin
          INSERT_LNAME.Text := '';
          AdvOfficeCheckBox1.Checked := false;
          INSERT_LNAME.SetFocus;
        end;
        CloseFile(Login);
        AdvIPEdit1.IPAddress := Trim(serverip);
        AdvLUEdit1.Text := portip;
        AdvLUEdit2.Text := usern;
        AdvLUEdit3.Text := pass;
        AdvLUEdit4.Text := chemin;

        with FDATA.FDC.Params as TFDPhysFBConnectionDefParams do
        begin
          Server := serverip;
          Port := strtoint(portip);
          UserName := usern;
          Password := pass;
          Database := chemin;
        end;
        try
          FDATA.FDC.Connected := true;
          HoverLine.Color := clGreen;
          HoverLine.Colorto := clGreen;
          CardPanel1.Cards[0].Show
        except
          messagedlg('Œÿ√ ›Ì «·≈ ’«·  Õﬁﬁ „‰ «·≈⁄œ«œ« ', TMsgDlgType.mtError,
            [mbOK], 0);
          HoverLine.Color := $007C7CFF;
          HoverLine.Colorto := $006868FF;
        end;

      END;
    end
    else
    begin
      CardPanel1.ActiveCard := Activ;
      AdvLUEdit6.Text := hdd;
    end;

  END
  else
  begin
    CardPanel1.ActiveCard := Activ;
    AdvLUEdit6.Text := hdd;
    exit;

  end;

end;

