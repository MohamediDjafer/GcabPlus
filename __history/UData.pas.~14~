procedure TFData.OCSAfterPost(DataSet: TDataSet);
begin
if FAdd_Consu.ToggleSwitch1.State = fOn then
  begin
  with FData.SUMM do
    begin
      Close;
      SQL.Clear;
      SQL.Text := 'SELECT SUM(CS_QTE * CS_PRICE) FROM TConsum WHERE ID_OUT = '+QuotedStr(FData.TOUT_Test.FieldByName('ID_OUT').AsString);
      Open();
    end;
  end
else
  begin
      with FData.SUMM do
    begin
      Close;
      SQL.Clear;
      SQL.Text := 'SELECT SUM(CS_QTE * CS_PRICE) FROM TConsum WHERE ID_OUT = '+QuotedStr(FData.TOUT.FieldByName('ID_OUT').AsString);
      Open();
    end;
  end;

  FAdd_Consu.LBL_MONTANT.Caption := Format('%.2m', [FData.SUMM.Fields[0].AsFloat]);

end;

procedure TFData.OCSCalcFields(DataSet: TDataSet);
begin
  with OCS do
    begin
     FieldByName('MON').AsFloat := FieldByName('CS_QTE').AsFloat * FieldByName('CS_PRICE').AsFloat ;
    end;

end;

procedure TFData.TDepenseCalcFields(DataSet: TDataSet);
begin
with TDepense do
    begin
     FieldByName('MON').AsFloat := FieldByName('DEP_QTE').AsFloat * FieldByName('DEP_PRICE').AsFloat ;
    end;
end;

